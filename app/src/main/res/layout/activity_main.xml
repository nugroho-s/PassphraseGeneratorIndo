<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/mainContent"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">
    <TextView
      android:id="@+id/passphraseText"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="96dp"
      android:gravity="center"
      android:padding="16dp"
      android:saveEnabled="false"
      android:importantForAutofill="noExcludeDescendants"
      android:text="@string/passphrase_placeholder"
      android:textSize="22sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:labelFor="@id/numberInputText" android:text="@string/word_count_label" />
    <EditText android:id="@+id/numberInputText"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:minHeight="48dp" android:inputType="number" android:maxLength="2"
      android:importantForAutofill="no" android:text="@string/default_word_count" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:labelFor="@id/separatorInputText" android:text="@string/separator_label" />
    <EditText android:id="@+id/separatorInputText"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:minHeight="48dp" android:inputType="textNoSuggestions" android:maxLength="16"
      android:importantForAutofill="no" android:text="@string/default_separator" />
    <CheckBox android:id="@+id/capitalizeCheckBox"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:minHeight="48dp" android:text="@string/capitalize_label" />
    <CheckBox android:id="@+id/useNumberCheckBox"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:minHeight="48dp" android:text="@string/number_label" />
    <CheckBox android:id="@+id/useSymbolCheckBox"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:minHeight="48dp" android:text="@string/symbol_label" />
    <Button android:id="@+id/generatorButton"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:minHeight="48dp" android:text="@string/generate_label" />
    <Button android:id="@+id/copyButton"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:minHeight="48dp" android:enabled="false" android:text="@string/copy_label" />
    <Button android:id="@+id/clearButton"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:minHeight="48dp" android:enabled="false" android:text="@string/clear_label" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:paddingTop="16dp" android:text="@string/security_hint" />
  </LinearLayout>
</ScrollView>
